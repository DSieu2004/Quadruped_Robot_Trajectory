{
  "version": 4,
  "configurations": [
    {
      "name": "Go2 ROS 2 and MuJoCo",
      "compilerPath": "/usr/bin/g++",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64",
      "compileCommands": "${workspaceFolder}/ros2_build/go2_smc_ros/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/include",
        "/usr/include/eigen3",
        "/opt/ros/humble/include/**",
        "${workspaceFolder}/third_party/ros_deps/root/opt/ros/humble/include/**",
        "${workspaceFolder}/third_party/mujoco-3.3.5/include"
      ]
    }
  ]
}
